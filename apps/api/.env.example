# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://tooltrace:tooltrace_local_only@localhost:5432/tooltrace

# Web app URL (used in invite links)
APP_URL=http://localhost:3000

# Passkeys: the web app's domain and origin(s)
RP_ID=localhost
RP_NAME=ToolTrace
RP_ORIGINS=http://localhost:3000

# false ONLY for plain-http localhost. Production refuses to start with false.
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=72
AUTH_RATE_LIMIT_PER_MINUTE=30
