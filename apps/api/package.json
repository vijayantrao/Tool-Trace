    "hono": "^4.13.13",
    "mqtt": "^5.16.0",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "aedes": "^1.2.0",
